desc:AI Band Humanizer
tags:MIDI humanize AI Band

slider1:0<0,30,1>Timing humanize (ms)
slider2:0<0,30,1>Velocity humanize

@block
while (midirecv(offset, msg1, msg23)) (
  status = msg1 & $xF0;
  note = msg23 & $x7F;
  vel = (msg23 / 256) & $x7F;

  slider1 > 0 ? (
    jitter = floor((rand(2) - 1) * slider1 * srate / 1000);
    offset = min(max(offset + jitter, 0), samplesblock - 1);
  );

  status == $x90 && vel > 0 && slider2 > 0 ? (
    vel = min(max(vel + floor((rand(2) - 1) * slider2), 1), 127);
    msg23 = note | (vel * 256);
  );

  midisend(offset, msg1, msg23);
);
